{
  "name": "@dawnlight/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @dawnlight/config build && pnpm --filter @dawnlight/database build && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "types:check": "tsc -p tsconfig.json --noEmit",
    "check:config": "tsx src/check-config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@dawnlight/config": "workspace:*",
    "@dawnlight/database": "workspace:*",
    "pg-boss": "^12.5.0",
    "pino": "^10.1.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "yazl": "^3.3.1"
  }
}
