{
  "name": "@dawnlight/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @dawnlight/config build && pnpm --filter @dawnlight/contract-data build && pnpm --filter @dawnlight/api-client build && pnpm --filter @dawnlight/database build && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "types:check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @dawnlight/config build && pnpm --filter @dawnlight/contract-data build && pnpm --filter @dawnlight/api-client build && pnpm --filter @dawnlight/database build && vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@dawnlight/api-client": "workspace:*",
    "@dawnlight/config": "workspace:*",
    "@dawnlight/contract-data": "workspace:*",
    "@dawnlight/database": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/formbody": "^9.0.0",
    "@opentelemetry/api": "^1.9.0",
    "fastify": "^5.6.1",
    "openid-client": "^6.8.5",
    "pg": "^8.16.3",
    "pg-boss": "^12.27.0",
    "pino": "^10.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
