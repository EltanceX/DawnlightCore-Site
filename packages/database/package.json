{
  "name": "@dawnlight/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations",
    "scripts"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "pnpm --filter @dawnlight/contract-data build && tsc -p tsconfig.json",
    "types:check": "tsc -p tsconfig.json --noEmit",
    "migrate:up": "node scripts/migrate-up.mjs",
    "seed": "node scripts/seed.mjs",
    "contract:ingest": "node scripts/ingest-contract.mjs",
    "directory:seed": "node scripts/seed-directory.mjs",
    "authoring:seed": "node scripts/seed-authoring.mjs",
    "operations:smoke": "pnpm build && node scripts/smoke-search-operations.mjs",
    "takedown:smoke": "pnpm build && node scripts/smoke-takedown-staging.mjs",
    "release:smoke": "pnpm build && node scripts/smoke-release-staging.mjs"
  },
  "dependencies": {
    "@dawnlight/contract-data": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.15.5",
    "typescript": "^7.0.2"
  }
}
