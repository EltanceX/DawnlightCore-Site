# Generate the real untracked file instead of copying these placeholders:
# HTTP-only disposable staging:
# node scripts/create-wp9-a-env.mjs --public-origin http://192.0.2.10:58080 --oidc-origin http://192.0.2.10:58082 --docker-gid 998
# Optional public TLS edge (certificate paths are absolute paths on the Docker host):
# node scripts/create-wp9-a-env.mjs --public-origin https://core.example.test --oidc-origin http://192.0.2.10:58082 --docker-gid 998 --tls-cert-file /srv/dawnlight/secrets/core.example.test.crt --tls-key-file /srv/dawnlight/secrets/core.example.test.key
WP9_PUBLIC_ORIGIN=http://192.0.2.10:58080
WP9_PUBLIC_HOST=192.0.2.10
WP9_OIDC_ORIGIN=http://192.0.2.10:58082
WP9_BIND_ADDRESS=0.0.0.0
WP9_HTTP_PORT=58080
WP9_OIDC_BIND_ADDRESS=0.0.0.0
WP9_OIDC_PORT=58082
WP9_IMAGE_REVISION=<40-character-clean-commit>
WP9_IMAGE_CREATED=<commit-ISO-8601-time>
WP9_SOURCE_DATE_EPOCH=<commit-unix-time>
WP9_IMAGE_SOURCE=https://github.com/EltanceX/DawnlightCore-Site
WP9_IMAGE_VERSION=0.1.0
WP9_POSTGRES_PASSWORD=<generated>
WP9_MINIO_ROOT_USER=dawnlight-wp9-a
WP9_MINIO_ROOT_PASSWORD=<generated>
WP9_OIDC_CLIENT_SECRET=<generated>
WP9_AUTH_COOKIE_SECRET=<generated-at-least-32-characters>
WP9_RELEASE_FEED_SIGNING_KEY_ID=<generated>
WP9_RELEASE_FEED_SIGNING_PRIVATE_KEY_PEM_BASE64=<generated>
WP9_VALIDATOR_ENABLED=false
WP9_VALIDATOR_WORKSPACE_ROOT=/srv/dawnlight-wp9-a/validator-workspaces
WP9_DOCKER_GID=998
WP9_BOOTSTRAP_ADMIN_EMAIL=author@example.test
# HTTPS-only values emitted by create-wp9-a-env.mjs:
# WP9_TLS_BIND_ADDRESS=0.0.0.0
# WP9_TLS_HTTP_PORT=80
# WP9_TLS_HTTPS_PORT=443
# WP9_TLS_CERT_FILE=/srv/dawnlight/secrets/core.example.test.crt
# WP9_TLS_KEY_FILE=/srv/dawnlight/secrets/core.example.test.key
