{
	auto_https off
	admin off
}
:8080 {
	root * /srv
	encode zstd gzip

	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@feeds path /feeds/*
	header @feeds Cache-Control "public, max-age=60, must-revalidate"

	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
