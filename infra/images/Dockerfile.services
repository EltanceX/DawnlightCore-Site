# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:26-bookworm-slim@sha256:cd565714d4da3e84bfd341e31448f81d47c6362198f152345297c9c1154e6341
ARG DOCKER_CLI_IMAGE=docker:29-cli@sha256:000bb62ff495f986c9f5578eb67cc2cb98b91138eda81d7762d5371eb8a497fe

FROM ${DOCKER_CLI_IMAGE} AS docker-cli

FROM ${NODE_IMAGE} AS build
ARG IMAGE_REVISION
ARG SOURCE_DATE_EPOCH
ENV NODE_ENV=development \
    PNPM_HOME=/opt/pnpm \
    PATH=/opt/pnpm:$PATH \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
WORKDIR /workspace
RUN test -n "${IMAGE_REVISION}" && test -n "${SOURCE_DATE_EPOCH}" && \
    npm install --global --ignore-scripts pnpm@11.19.0
COPY . .
RUN pnpm install --frozen-lockfile && \
    pnpm services:build && \
    pnpm --filter @dawnlight/api deploy --prod --legacy /deploy/api && \
    pnpm --filter @dawnlight/worker deploy --prod --legacy /deploy/worker && \
    pnpm --filter @dawnlight/database deploy --prod --legacy /deploy/database && \
    cp -P /deploy/database/node_modules/pg /deploy/worker/node_modules/pg && \
    mkdir -p /deploy/shared && \
    cp -RL /workspace/packages/config/node_modules/zod /deploy/shared/zod

FROM ${NODE_IMAGE} AS runtime-base
ARG IMAGE_CREATED
ARG IMAGE_REVISION
ARG IMAGE_SOURCE=https://github.com/EltanceX/DawnlightCore-Site
ARG IMAGE_VERSION=0.1.0
ENV NODE_ENV=production
RUN groupadd --gid 10001 dawnlight && \
    useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent \
      --shell /usr/sbin/nologin dawnlight
LABEL org.opencontainers.image.created="${IMAGE_CREATED}" \
      org.opencontainers.image.revision="${IMAGE_REVISION}" \
      org.opencontainers.image.source="${IMAGE_SOURCE}" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.vendor="DawnlightCore" \
      org.opencontainers.image.licenses="UNLICENSED"

FROM runtime-base AS api
LABEL org.opencontainers.image.title="Dawnlight API" \
      org.opencontainers.image.description="DawnlightCore developer portal and shader distribution API"
ENV API_HOST=0.0.0.0 \
    API_PORT=4100
WORKDIR /app
COPY --from=build --chown=10001:10001 /deploy/api/ ./
RUN rm -rf /app/node_modules/@dawnlight/config \
      /app/node_modules/@dawnlight/contract-data \
      /app/node_modules/@dawnlight/api-client \
      /app/node_modules/@dawnlight/database && \
    mkdir -p /app/node_modules/@dawnlight/config \
      /app/node_modules/@dawnlight/contract-data \
      /app/node_modules/@dawnlight/api-client \
      /app/node_modules/@dawnlight/database
COPY --from=build --chown=10001:10001 /workspace/packages/config/package.json /app/node_modules/@dawnlight/config/package.json
COPY --from=build --chown=10001:10001 /workspace/packages/config/dist/ /app/node_modules/@dawnlight/config/dist/
COPY --from=build --chown=10001:10001 /workspace/packages/contract-data/package.json /app/node_modules/@dawnlight/contract-data/package.json
COPY --from=build --chown=10001:10001 /workspace/packages/contract-data/dist/ /app/node_modules/@dawnlight/contract-data/dist/
COPY --from=build --chown=10001:10001 /workspace/packages/api-client/package.json /app/node_modules/@dawnlight/api-client/package.json
COPY --from=build --chown=10001:10001 /workspace/packages/api-client/dist/ /app/node_modules/@dawnlight/api-client/dist/
COPY --from=build --chown=10001:10001 /workspace/packages/database/package.json /app/node_modules/@dawnlight/database/package.json
COPY --from=build --chown=10001:10001 /workspace/packages/database/dist/ /app/node_modules/@dawnlight/database/dist/
COPY --from=build --chown=10001:10001 /deploy/shared/zod/ /app/node_modules/zod/
COPY --from=build --chown=10001:10001 /deploy/database/ /opt/dawnlight/database/
RUN rm -rf /opt/dawnlight/database/node_modules/@dawnlight/contract-data \
      /opt/dawnlight/database/node_modules/zod && \
    mkdir -p /opt/dawnlight/database/node_modules/@dawnlight/contract-data && \
    ln -s /app/node_modules/zod /opt/dawnlight/database/node_modules/zod
COPY --from=build --chown=10001:10001 /workspace/packages/contract-data/package.json /opt/dawnlight/database/node_modules/@dawnlight/contract-data/package.json
COPY --from=build --chown=10001:10001 /workspace/packages/contract-data/dist/ /opt/dawnlight/database/node_modules/@dawnlight/contract-data/dist/
COPY --from=build --chown=10001:10001 /workspace/contracts/dawnlight/preview/ /opt/dawnlight/contracts/preview/
USER 10001:10001
EXPOSE 4100
CMD ["node", "dist/main.js"]

FROM runtime-base AS worker
LABEL org.opencontainers.image.title="Dawnlight Worker" \
      org.opencontainers.image.description="DawnlightCore quarantine, Loader validation and publication worker"
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /app
COPY --from=build --chown=10001:10001 /deploy/worker/ ./
RUN rm -rf /app/node_modules/@dawnlight/config \
      /app/node_modules/@dawnlight/contract-data \
      /app/node_modules/@dawnlight/database && \
    mkdir -p /app/node_modules/@dawnlight/config \
      /app/node_modules/@dawnlight/contract-data \
      /app/node_modules/@dawnlight/database
COPY --from=build --chown=10001:10001 /workspace/packages/config/package.json /app/node_modules/@dawnlight/config/package.json
COPY --from=build --chown=10001:10001 /workspace/packages/config/dist/ /app/node_modules/@dawnlight/config/dist/
COPY --from=build --chown=10001:10001 /workspace/packages/contract-data/package.json /app/node_modules/@dawnlight/contract-data/package.json
COPY --from=build --chown=10001:10001 /workspace/packages/contract-data/dist/ /app/node_modules/@dawnlight/contract-data/dist/
COPY --from=build --chown=10001:10001 /workspace/packages/database/package.json /app/node_modules/@dawnlight/database/package.json
COPY --from=build --chown=10001:10001 /workspace/packages/database/dist/ /app/node_modules/@dawnlight/database/dist/
COPY --from=build --chown=10001:10001 /deploy/shared/zod/ /app/node_modules/zod/
USER 10001:10001
CMD ["node", "dist/main.js"]
