{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dawnlight:shaderpack:preview",
  "title": "Dawnlight Shader Pack Manifest v3 (Preview)",
  "description": "Website preview schema. Runtime semantics remain defined by the locked C# Loader.",
  "type": "object",
  "additionalProperties": true,
  "required": ["manifestVersion", "id", "name", "version", "shaderRoot"],
  "properties": {
    "manifestVersion": { "const": 3 },
    "sourceFormatVersion": { "type": "integer", "minimum": 1 },
    "id": { "$ref": "#/$defs/identifier" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "shaderRoot": { "type": "string", "pattern": "^[^/\\\\].*" },
    "settings": { "type": "string", "pattern": "^[^/\\\\].*\\.json$" },
    "fragments": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "options": { "type": "array", "items": { "$ref": "#/$defs/option" } },
    "resources": { "type": "array", "items": { "type": "object" } },
    "programs": { "type": "array", "items": { "type": "object" } },
    "passes": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+:[a-zA-Z0-9._/-]+$"
    },
    "option": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "type", "default", "impact"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "enum": ["boolean", "integer", "number", "string"] },
        "default": {},
        "impact": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
