  "pages": [
    {
      "id": "basic",
      "title": "page.basic",
      "order": 100,
      "groups": [
        {
          "id": "visual",
          "title": "group.basic.visual",
          "order": 100,
          "controls": [
            {
              "id": "tone-mapping",
              "option": "dawnlight:post/tone_mapping",
              "widget": "choice",
              "label": "option.post.tone_mapping",
              "values": [
                { "value": "default", "label": "value.post.default" },
                { "value": "vanilla", "label": "value.post.vanilla" },
                { "value": "vivid", "label": "value.post.vivid" },
                { "value": "experimental", "label": "value.post.experimental" },
                { "value": "none", "label": "value.post.none" }
              ]
            },
            {
              "id": "dynamic-blur",
              "option": "dawnlight:post/dynamic_blur",
              "widget": "toggle",
              "label": "option.post.dynamic_blur"
            },
            {
              "id": "plant-waving",
              "option": "dawnlight:terrain/plant_waving",
              "widget": "toggle",
              "label": "option.terrain.plant_waving"
            },
            {
              "id": "plant-interaction",
              "option": "dawnlight:terrain/plant_interaction",
              "widget": "toggle",
              "label": "option.terrain.plant_interaction"
            }
          ]
        },
        {
          "id": "fireflies",
          "title": "group.basic.fireflies",
          "order": 200,
          "controls": [
            {
              "id": "firefly-mode",
              "option": "dawnlight:effects/firefly_mode",
              "widget": "choice",
              "label": "option.effects.firefly_mode",
              "description": "description.effects.firefly_mode",
              "values": [
                { "value": "disabled", "label": "value.common.disabled" },
                { "value": "standard", "label": "value.firefly.standard" },
                { "value": "always", "label": "value.firefly.always" }
              ],
              "enabledWhen": [
                { "option": "dawnlight:compatibility/ssbo_disabled", "equals": false }
              ]
            },
            {
              "id": "firefly-density",
              "option": "dawnlight:effects/firefly_density",
              "widget": "slider",
              "label": "option.effects.firefly_density",
              "min": 1024,
              "max": 10240,
              "step": 512,
              "enabledWhen": [
                { "option": "dawnlight:effects/firefly_mode", "notEquals": "disabled" },
                { "option": "dawnlight:compatibility/ssbo_disabled", "equals": false }
              ]
            }
          ]
        },
        {
          "id": "earth",
          "title": "group.basic.earth",
          "order": 300,
          "controls": [
            {
              "id": "earth-effect",
              "option": "dawnlight:terrain/earth_effect",
              "widget": "toggle",
              "label": "option.terrain.earth_effect"
            },
            {
              "id": "earth-effect-strength",
              "option": "dawnlight:terrain/earth_effect_strength",
              "widget": "slider",
              "label": "option.terrain.earth_effect_strength",
              "min": 0.04,
              "max": 0.5,
              "step": 0.02,
              "enabledWhen": [
                { "option": "dawnlight:terrain/earth_effect", "equals": true }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "shadow",
      "title": "page.shadow",
      "order": 200,
      "groups": [
        {
          "id": "main",
          "title": "group.shadow.main",
          "order": 100,
          "controls": [
            {
              "id": "shadow-mode",
              "option": "dawnlight:shadows/mode",
              "widget": "choice",
              "label": "option.shadows.mode",
              "values": [
                { "value": "terrainAndEntity", "label": "value.shadow.terrain_and_entity" },
                { "value": "terrainOnly", "label": "value.shadow.terrain_only" },
                { "value": "entityOnly", "label": "value.shadow.entity_only" },
                { "value": "disabled", "label": "value.common.disabled" }
              ]
            },
            {
              "id": "pcf",
              "option": "dawnlight:shadows/pcf",
              "widget": "toggle",
              "label": "option.shadows.pcf",
              "enabledWhen": [
                { "option": "dawnlight:shadows/mode", "notEquals": "disabled" }
              ]
            },
            {
              "id": "refresh-rate",
              "option": "dawnlight:shadows/refresh_rate",
              "widget": "slider",
              "label": "option.shadows.refresh_rate",
              "description": "description.shadows.refresh_rate",
              "min": 1,
              "max": 6,
              "step": 1,
              "enabledWhen": [
                {
                  "option": "dawnlight:shadows/mode",
                  "in": ["terrainAndEntity", "terrainOnly"]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "water",
      "title": "page.water",
      "order": 300,
      "groups": [
        {
          "id": "main",
          "title": "group.water.main",
          "order": 100,
          "controls": [
            {
              "id": "water-effect",
              "option": "dawnlight:post/water_effect",
              "widget": "toggle",
              "label": "option.post.water_effect"
            },
            {
              "id": "transparency",
              "option": "dawnlight:water/transparency",
              "widget": "choice",
              "label": "option.water.transparency",
              "values": [
                { "value": "max", "label": "value.water.maximum" },
                { "value": "high", "label": "value.common.high" },
                { "value": "medium", "label": "value.common.medium" },
                { "value": "low", "label": "value.common.low" }
              ]
            },
            {
              "id": "fog-density",
              "option": "dawnlight:water/fog_density",
              "widget": "slider",
              "label": "option.water.fog_density",
              "min": 0.01,
              "max": 0.12,
              "step": 0.01
            },
            {
              "id": "depth-density",
              "option": "dawnlight:water/depth_density",
              "widget": "slider",
              "label": "option.water.depth_density",
              "min": 0.01,
              "max": 0.12,
              "step": 0.01
            },
            {
              "id": "specular",
              "option": "dawnlight:water/specular",
              "widget": "toggle",
              "label": "option.water.specular"
            },
            {
              "id": "advanced-wave",
              "option": "dawnlight:water/advanced_wave",
              "widget": "toggle",
              "label": "option.water.advanced_wave",
              "description": "description.water.advanced_wave",
              "enabledWhen": [
                { "option": "dawnlight:compatibility/ssbo_disabled", "equals": false }
              ]
            }
          ]
        },
        {
          "id": "effects",
          "title": "group.water.effects",
          "order": 200,
          "controls": [
            {
              "id": "ripple",
              "option": "dawnlight:water/ripple",
              "widget": "toggle",
              "label": "option.water.ripple",
              "enabledWhen": [
                { "option": "dawnlight:compatibility/ssbo_disabled", "equals": false }
              ]
            },
            {
              "id": "ground-infiltration",
              "option": "dawnlight:terrain/ground_infiltration",
              "widget": "toggle",
              "label": "option.terrain.ground_infiltration"
            },
            {
              "id": "puddle-reflection",
              "option": "dawnlight:water/puddle_reflection",
              "widget": "toggle",
              "label": "option.water.puddle_reflection"
            },
            {
              "id": "density-perturbation",
              "option": "dawnlight:screen/density_perturbation",
              "widget": "toggle",
              "label": "option.screen.density_perturbation"
            }
          ]
        }
      ]
    },
    {
      "id": "light",
      "title": "page.light",
      "order": 400,
      "groups": [
        {
          "id": "dynamic",
          "title": "group.light.dynamic",
          "order": 100,
          "controls": [
            {
              "id": "handheld-mode",
              "option": "dawnlight:lighting/handheld_mode",
              "widget": "choice",
              "label": "option.lighting.handheld_mode",
              "values": [
                { "value": "on", "label": "value.handheld.on" },
                { "value": "always", "label": "value.handheld.always" },
                { "value": "off", "label": "value.handheld.off" }
              ]
            },
            {
              "id": "rgb-torch",
              "option": "dawnlight:lighting/rgb_torch",
              "widget": "toggle",
              "label": "option.lighting.rgb_torch",
              "enabledWhen": [
                { "option": "dawnlight:lighting/handheld_mode", "notEquals": "off" }
              ]
            },
            {
              "id": "point-lights",
              "option": "dawnlight:lighting/point_lights",
              "widget": "toggle",
              "label": "option.lighting.point_lights",
              "description": "description.lighting.point_lights",
              "enabledWhen": [
                { "option": "dawnlight:compatibility/ssbo_disabled", "equals": false }
              ]
            },
            {
              "id": "handheld-radius",
              "option": "dawnlight:lighting/handheld_radius_multiplier",
              "widget": "slider",
              "label": "option.lighting.handheld_radius_multiplier",
              "unit": "x",
              "min": 0.5,
              "max": 2.0,
              "step": 0.05,
              "enabledWhen": [
                { "option": "dawnlight:lighting/handheld_mode", "notEquals": "off" }
              ]
            },
            {
              "id": "circuit-point-lights",
              "option": "dawnlight:lighting/circuit_point_lights",
              "widget": "toggle",
              "label": "option.lighting.circuit_point_lights",
              "enabledWhen": [
                { "option": "dawnlight:lighting/point_lights", "equals": true },
